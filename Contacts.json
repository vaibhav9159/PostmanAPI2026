  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const resp = pm.response.json();\n\nconst tokenID = resp.token;\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Token is present in response\", function () {\n    pm.expect(tokenID).to.not.be.null;\n});\n\nconsole.log(\"token generated =====> \"+ tokenID);\n\npm.collectionVariables.set(\"getTokenID\", tokenID);\n\n\npm.test(\"Response time is less than 1500ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(1500);\n});\n\npm.test(\"User object contains expected fields\", function () {\n    pm.expect(resp).to.have.property('user');\n    pm.expect(resp.user).to.have.property('_id');\n    pm.expect(resp.user).to.have.property('email');\n    pm.expect(resp.user.email).to.be.a('string');\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseurl}}/users/login",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "users",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "AddContact",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\n    const resp = pm.response.json();\n    const getContactID = resp._id;\n    console.log(\"contactID====>\"+ getContactID);\n\n    pm.test(\"Contact ID is not null\", function () {\n        pm.expect(getContactID).to.not.be.null;\n    });\n\n    pm.variables.set(\"contactID\", getContactID);\n\n\n\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function getNumber(){\n   return Math.floor(Math.random() * 10000000000); \n \n}\nconst phoneNumber = getNumber();\nconsole.log(phoneNumber);\npm.variables.set(\"phone\",phoneNumber)\n\n"
            ]
          }
        }
      ],
